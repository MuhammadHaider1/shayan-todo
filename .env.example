# Copy to .env (or export in your shell) — never commit real keys.

# Linear personal API key: linear.app > Settings > API > Create key
LINEAR_API_KEY=lin_api_...

# Agent backend for the loop: codex (default) | gemini | claude
AGENT=codex

# Free Google AI Studio key — only needed for AGENT=gemini and the CI discovery job.
GEMINI_API_KEY=

# Which GitHub repo the loop targets.
REPO=MuhammadHaider1/shayan-todo